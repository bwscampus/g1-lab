# Copy to .env (git-ignored) and fill in one provider. Exported variables win over this file.
#
#   cp .env.example .env
#
# The vision-language model (search, describe, demo keyframe selection) is any
# OpenAI-compatible chat-completions API. Pick the provider, name the model, and
# set that provider's key. Defaults: VLM_PROVIDER=huggingface with vlm.DEFAULT_MODEL.

# --- provider: huggingface (default) --------------------------------------------------
# Hugging Face Inference Providers. Fine-grained token with "Make calls to Inference Providers".
VLM_PROVIDER=huggingface
HF_TOKEN=hf_...
# Optional: the router's default is Qwen/Qwen3-VL-30B-A3B-Instruct; ":deepinfra" etc. pins a provider.
# VLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct:deepinfra

# --- provider: openai -------------------------------------------------------------------
# VLM_PROVIDER=openai
# VLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- provider: openrouter ---------------------------------------------------------------
# VLM_PROVIDER=openrouter
# VLM_MODEL=qwen/qwen2.5-vl-72b-instruct
# OPENROUTER_API_KEY=sk-or-...

# --- providers: groq | together | deepinfra | mistral | xai | gemini --------------------
# VLM_PROVIDER=groq          GROQ_API_KEY=...       VLM_MODEL=...
# VLM_PROVIDER=together      TOGETHER_API_KEY=...   VLM_MODEL=...
# VLM_PROVIDER=deepinfra     DEEPINFRA_API_KEY=...  VLM_MODEL=...
# VLM_PROVIDER=mistral       MISTRAL_API_KEY=...    VLM_MODEL=...
# VLM_PROVIDER=xai           XAI_API_KEY=...        VLM_MODEL=...
# VLM_PROVIDER=gemini        GEMINI_API_KEY=...     VLM_MODEL=...

# --- provider: ollama (local, no key) ---------------------------------------------------
# VLM_PROVIDER=ollama
# VLM_MODEL=qwen2.5vl
# VLM_BASE_URL=http://localhost:11434/v1        # only if Ollama is not on its default port

# --- provider: custom (any OpenAI-compatible /v1 server: vLLM, llama.cpp, a proxy) ------
# VLM_PROVIDER=custom
# VLM_BASE_URL=http://host:8000/v1
# VLM_MODEL=...
# VLM_API_KEY=...                                # only if the server wants one

# --- overrides that work with any provider ----------------------------------------------
# VLM_BASE_URL=...                               # a different endpoint for the chosen provider
# VLM_API_KEY=...                                # used instead of the provider's own key variable

# --- robot camera (--env robot with a camera policy) --------------------------------------
# UNITREE_ROBOT_IP=192.168.123.161
# UNITREE_AES_128_KEY=...                        # per device, from unitree-fetch-aes-key

# --- run defaults --------------------------------------------------------------------------
# G1_ENV=sim
# G1_POLICY=search
# G1_MJCF=/path/to/mujoco_menagerie/unitree_g1/scene.xml
