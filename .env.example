# Copy to .env (git-ignored) and fill in. Exported variables win over this file.
#
#   cp .env.example .env

# --- vision-language model: Hugging Face Inference Providers ------------------------------
# Used by search (g1 run --tools search, g1 task run), g1 decide and demo keyframe selection. A fine-grained token with the
# "Make calls to Inference Providers" permission: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Optional. The default is Qwen/Qwen3-VL-30B-A3B-Instruct; a suffix pins one of the
# router's providers, which helps when structured output comes back malformed.
# VLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct:deepinfra

# Optional. Another Hugging Face endpoint, e.g. a dedicated Inference Endpoint.
# VLM_BASE_URL=https://<name>.endpoints.huggingface.cloud/v1

# --- robot camera (--env robot with the agent; g1 camera to smoke-test it) -----------------
# UNITREE_IFACE=en7                # the laptop's interface on the robot's network (or the robot's IP): --iface
# UNITREE_ROBOT_IP=192.168.123.161 # the head camera's address: --camera-ip
# UNITREE_AES_128_KEY=...          # per robot: unitree-fetch-aes-key --email you@example.com

# --- run defaults --------------------------------------------------------------------------
# G1_ENV=sim
# G1_TOOLS=search
# G1_MJCF=/path/to/mujoco_menagerie/unitree_g1/scene.xml
